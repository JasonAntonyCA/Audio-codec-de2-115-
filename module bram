module bram(input clk , rst , din , output reg [23:0] dout );

reg [7:0] memory [0:1023];
reg [9:0] pcount , mc;
reg [3:0] scount;
reg [23:0] sr;
reg [1:0] ecount;
reg en ;


always@(posedge clk) begin
	if(rst) begin
		sr <= 8'd0;
		scount <= 4'd0;
		en <= 1'b0;
	end
	else begin
		if(scount == 4'd23) begin
			scount <= 4'd0;
			en <= 1'b1;
			sr <= {sr[22:0], din};
		end
		else begin
			sr <= {sr[23:0], din};
			scount <= scount + 1'b1;
			en <= 1'b0;
		end
	end
end


