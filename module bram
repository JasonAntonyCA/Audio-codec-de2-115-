			memory [pcount] <= sr;
		end
		else if(pcount < 10'd1023) begin
				pcount <= pcount + 1'b1;
				memory [pcount] <= sr;
		end
		end
	end
end*/

wire signed [23:0] sample = sr;
wire [23:0] mag = sample[23] ? (~sample + 24'd1) : sample;
wire [24:0] mag_x2 = {mag, 1'b0};
wire [23:0] mag_scld = mag_x2[24] ? 24'hFFFFFF : mag_x2[23:0];

always@(posedge clk) begin
	if(rst)begin
		dout <= 24'd0;
		mc <= 10'd0;
	end
	else begin
		if(en) begin
		dout <= mag_scld;
		//dout <= memory[0];
		//mc <= mc + 1'b1;
		end
	end
end

endmodule

